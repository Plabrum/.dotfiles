#!/usr/bin/env python3
"""agent-loop — spawn repeating Claude Code sessions against a tt, Linear or GitHub Issues backlog."""

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timedelta
from pathlib import Path

# ---------------------------------------------------------------------------
# Picker constants
# ---------------------------------------------------------------------------

DEFAULT_SKIP_LABELS = ["epic", "tracker"]
DEFAULT_PRIORITY_LABELS = ["bug"]
EPIC_TITLE_RE = re.compile(r"^Epic:\s", re.IGNORECASE)
DEPENDENCY_RE = re.compile(r"\b(?:blocked by|depends on)\s+#(\d+)", re.IGNORECASE)
PR_CLOSES_RE = re.compile(r"\b(?:closes|fixes|resolves)\s+#(\d+)\b", re.IGNORECASE)
TICKET_MARKER = "{{TICKET}}"
LINEAR_GRAPHQL_URL = "https://api.linear.app/graphql"

TT_PROJECT_AUTO = "\x00auto"  # sentinel for bare --tt-project (resolve from cwd)

# tt has no `shelved` status and no labels, so a ticket that keeps failing has
# nowhere durable to record "stop picking me". We track attempts in-process and
# drop a ticket for the rest of the loop's life once it hits this ceiling.
TT_MAX_ATTEMPTS = 2

SCRIPT_DIR = Path(__file__).resolve().parent

DEFAULT_PROMPT = """\
You are running headless via agent-loop. No human will answer questions in this session.

{{TICKET}}

Before doing anything: read CLAUDE.md, then run `git log --oneline -15` and `git status`.

Execute exactly what the ticket says. Follow its close instructions when done. Stop after the close step.

Hard rules: never push to main/master, never force-push, never --no-verify. \
If the working tree is dirty at session start, abort. \
If the ticket is ambiguous or out-of-scope, post a comment explaining why and stop — don't guess.\
"""


# ---------------------------------------------------------------------------
# Embedded meta-prompt for `agent-loop init`
# ---------------------------------------------------------------------------

INIT_META_PROMPT = """\
Help the user get agent-loop running on their project. Ask these questions one at a time:

1. Where is the backlog? (a) tt — project slug, or blank to resolve it from the project's path \
(b) Linear — project name + state that means "ready", e.g. "Backlog" \
(c) GitHub Issues — owner/repo + optional label filter (d) neither
2. How should tickets be closed? commit-on-branch (default) or feature-branch + PR?
3. Any hard constraints? (e.g. never push to main, labels to skip)

Then print the exact `agent-loop run` command to copy-paste.
"""

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def parse_duration(s: str) -> int:
    """Parse a duration string like '30m', '1h', '90s' into seconds."""
    m = re.fullmatch(r"(\d+)(s|m|h)", s.strip())
    if not m:
        raise argparse.ArgumentTypeError(
            f"Invalid duration '{s}'. Use format like 30m, 1h, 90s."
        )
    value, unit = int(m.group(1)), m.group(2)
    return value * {"s": 1, "m": 60, "h": 3600}[unit]


def parse_stop_at(s: str) -> datetime:
    """Parse HH:MM and return the next occurrence of that wall-clock time."""
    try:
        t = datetime.strptime(s, "%H:%M")
    except ValueError:
        raise argparse.ArgumentTypeError(f"Invalid time '{s}'. Use HH:MM format.")
    now = datetime.now()
    candidate = now.replace(hour=t.hour, minute=t.minute, second=0, microsecond=0)
    if candidate <= now:
        candidate += timedelta(days=1)
    return candidate


def past_deadline(deadline: datetime | None) -> bool:
    return deadline is not None and datetime.now() >= deadline


def _git(*args: str, fallback: str = "") -> str:
    try:
        return subprocess.check_output(["git", *args], stderr=subprocess.DEVNULL).decode().strip()
    except Exception:
        return fallback


def _gh(*args: str, timeout: int = 30) -> str | None:
    try:
        r = subprocess.run(["gh", *args], capture_output=True, text=True, timeout=timeout)
    except Exception:
        return None
    return r.stdout if r.returncode == 0 else None


def _linear_graphql(query: str, variables: dict | None = None) -> dict:
    """POST a GraphQL query to Linear. Raises on missing key, transport, or GraphQL errors."""
    api_key = os.environ.get("LINEAR_API_KEY")
    if not api_key:
        raise RuntimeError(
            "LINEAR_API_KEY is not set. agent-loop's Linear picker reads issues directly via "
            "the Linear GraphQL API (no MCP / haiku subprocess). Export your personal API key "
            "from https://linear.app/settings/api and re-run."
        )
    payload = json.dumps({"query": query, "variables": variables or {}}).encode("utf-8")
    req = urllib.request.Request(
        LINEAR_GRAPHQL_URL,
        data=payload,
        headers={
            "Authorization": api_key,
            "Content-Type": "application/json",
        },
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=30) as resp:
        body = json.loads(resp.read().decode("utf-8"))
    if body.get("errors"):
        raise RuntimeError(f"Linear GraphQL errors: {body['errors']}")
    return body.get("data") or {}


_LINEAR_LIST_QUERY = """
query AgentLoopList($project: String!, $state: String!) {
  issues(
    first: 100
    filter: {
      project: { name: { eq: $project } }
      state: { name: { eq: $state } }
    }
    orderBy: createdAt
  ) {
    nodes {
      id
      identifier
      title
      description
      createdAt
      labels { nodes { name } }
    }
  }
}
"""


_LINEAR_STATE_QUERY = """
query AgentLoopState($id: String!) {
  issue(id: $id) {
    state { name type }
  }
}
"""


_LINEAR_TEAM_STATES_QUERY = """
query AgentLoopTeamStates($id: String!) {
  issue(id: $id) {
    team {
      states {
        nodes { id name type }
      }
    }
  }
}
"""


_LINEAR_ISSUE_DETAILS_QUERY = """
query AgentLoopIssueDetails($id: String!) {
  issue(id: $id) {
    labels { nodes { name } }
  }
}
"""


_LINEAR_UPDATE_STATE_MUTATION = """
mutation AgentLoopUpdateState($id: String!, $stateId: String!) {
  issueUpdate(id: $id, input: { stateId: $stateId }) {
    success
  }
}
"""


def _linear_team_states(issue_id: str) -> list[dict]:
    """Return the issue's team's full state list, or [] on error."""
    try:
        data = _linear_graphql(_LINEAR_TEAM_STATES_QUERY, {"id": issue_id})
    except Exception:
        return []
    return (
        ((data.get("issue") or {}).get("team") or {}).get("states") or {}
    ).get("nodes") or []


def _pick_state(states: list[dict], preferred_names: list[str], state_type: str | None = None) -> dict | None:
    """Pick a state by preferred name (case-insensitive), falling back to first of state_type."""
    by_lower_name = {(s.get("name") or "").lower(): s for s in states}
    for name in preferred_names:
        s = by_lower_name.get(name.lower())
        if s:
            return s
    if state_type:
        for s in states:
            if s.get("type") == state_type:
                return s
    return None


def linear_mark_in_progress(issue_id: str) -> tuple[bool, str | None]:
    """Move the issue to 'In Progress' (preferred) or the first started-type state.

    Returns (success, state_name). Best-effort: returns (False, None) on any error.
    """
    states = _linear_team_states(issue_id)
    target = _pick_state(states, preferred_names=["In Progress"], state_type="started")
    if not target:
        return False, None
    try:
        result = _linear_graphql(
            _LINEAR_UPDATE_STATE_MUTATION,
            {"id": issue_id, "stateId": target["id"]},
        )
    except Exception:
        return False, None
    success = bool(((result.get("issueUpdate") or {}).get("success")))
    return success, target.get("name")


def linear_mark_backlog(issue_id: str) -> tuple[bool, str | None]:
    """Move the issue back to 'Backlog' (preferred) or the first backlog-type state.

    Returns (success, state_name). Best-effort: returns (False, None) on any error.
    """
    states = _linear_team_states(issue_id)
    target = _pick_state(states, preferred_names=["Backlog"], state_type="backlog")
    if not target:
        return False, None
    try:
        result = _linear_graphql(
            _LINEAR_UPDATE_STATE_MUTATION,
            {"id": issue_id, "stateId": target["id"]},
        )
    except Exception:
        return False, None
    success = bool(((result.get("issueUpdate") or {}).get("success")))
    return success, target.get("name")


def linear_issue_labels(issue_id: str) -> list[str]:
    """Return the issue's label names, or [] on error."""
    try:
        data = _linear_graphql(_LINEAR_ISSUE_DETAILS_QUERY, {"id": issue_id})
    except Exception:
        return []
    labels = ((data.get("issue") or {}).get("labels") or {}).get("nodes") or []
    return [l.get("name") or "" for l in labels]


def pick_linear_ticket(
    project: str,
    state: str,
    skip_labels: list[str],
    priority_labels: list[str],
    skip_deps: bool,
) -> dict | None:
    """Pick the next Linear ticket to work on.

    Returns a dict shaped {'kind': 'linear', 'identifier': str, 'id': str, 'title': str,
    'body': str, 'labels': [str], 'project': str} or None when nothing matches.
    """
    try:
        data = _linear_graphql(_LINEAR_LIST_QUERY, {"project": project, "state": state})
    except Exception as e:
        print(f"[agent-loop] Error: Linear list failed: {e}", file=sys.stderr)
        return None
    nodes = (data.get("issues") or {}).get("nodes") or []

    skip = {s.lower() for s in skip_labels}
    prio = {p.lower() for p in priority_labels}

    # For Linear, "blocked by / depends on" can reference identifiers like ENG-123,
    # but agent-loop doesn't fetch the relations graph. Use a conservative literal-match
    # against the descriptions of the same listing — same semantics as GitHub but on
    # identifier strings. Issues in any "open" state remain candidates.
    open_idents = {n["identifier"] for n in nodes}

    def _linear_has_dep(desc: str) -> bool:
        if not desc:
            return False
        for m in re.finditer(r"\b(?:blocked by|depends on)\s+([A-Z]+-\d+)", desc, re.IGNORECASE):
            if m.group(1).upper() in open_idents:
                return True
        return False

    eligible: list[dict] = []
    for n in nodes:
        labels = [l["name"] for l in (n.get("labels") or {}).get("nodes", [])]
        label_set = {l.lower() for l in labels}
        if label_set & skip:
            continue
        if EPIC_TITLE_RE.search(n.get("title") or ""):
            continue
        if skip_deps and _linear_has_dep(n.get("description") or ""):
            continue
        eligible.append({
            "kind": "linear",
            "identifier": n["identifier"],
            "id": n["id"],
            "title": n.get("title") or "",
            "body": n.get("description") or "",
            "labels": labels,
            "project": project,
            "_created": n.get("createdAt") or "",
            "_label_set": label_set,
        })

    if not eligible:
        return None

    eligible.sort(key=lambda t: (0 if t["_label_set"] & prio else 1, t["_created"]))
    chosen = eligible[0]
    chosen.pop("_label_set", None)
    chosen.pop("_created", None)
    return chosen


def linear_issue_state(issue_id: str) -> str | None:
    """Return the issue's state type (e.g. 'completed', 'started') or None on failure."""
    try:
        data = _linear_graphql(_LINEAR_STATE_QUERY, {"id": issue_id})
    except Exception:
        return None
    issue = data.get("issue") or {}
    state = issue.get("state") or {}
    return state.get("type")


def _has_dependency(body: str, open_numbers: set[int]) -> bool:
    """Return True if the body references an open issue via 'blocked by #N' / 'depends on #N'."""
    return any(int(m) in open_numbers for m in DEPENDENCY_RE.findall(body or ""))


def pick_github_ticket(
    repo: str,
    label: str | None,
    milestone: str | None,
    skip_labels: list[str],
    priority_labels: list[str],
    skip_deps: bool,
    close_mode: str = "commit",
) -> dict | None:
    """Pick the next GitHub ticket to work on.

    When close_mode == "pr", drop issues already referenced by an open PR via
    Closes/Fixes/Resolves #N — otherwise the loop would re-pick the same issue
    every iteration while the PR sits open waiting for merge.

    Returns a dict shaped {'kind': 'github', 'number': int, 'title': str, 'body': str,
    'labels': [str], 'repo': str} or None when nothing matches.
    """
    cmd = [
        "gh", "issue", "list",
        "--repo", repo,
        "--state", "open",
        "--json", "number,title,body,labels",
        "--limit", "100",
    ]
    if label:
        cmd += ["--label", label]
    if milestone:
        cmd += ["--milestone", milestone]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
    except Exception as e:
        print(f"[agent-loop] Error: gh issue list failed: {e}", file=sys.stderr)
        return None
    if result.returncode != 0:
        print(f"[agent-loop] Error: gh issue list failed: {result.stderr.strip()}", file=sys.stderr)
        return None
    issues = json.loads(result.stdout or "[]")

    skip = {s.lower() for s in skip_labels}
    prio = {p.lower() for p in priority_labels}
    open_numbers = {i["number"] for i in issues}
    pr_referenced = github_issues_with_open_prs(repo) if close_mode == "pr" else set()

    eligible: list[dict] = []
    for i in issues:
        labels = [l["name"] for l in i.get("labels", [])]
        label_set = {l.lower() for l in labels}
        if label_set & skip:
            continue
        if EPIC_TITLE_RE.search(i.get("title") or ""):
            continue
        if skip_deps and _has_dependency(i.get("body") or "", open_numbers):
            continue
        if i["number"] in pr_referenced:
            continue
        eligible.append({
            "kind": "github",
            "number": i["number"],
            "title": i.get("title") or "",
            "body": i.get("body") or "",
            "labels": labels,
            "repo": repo,
            "_label_set": label_set,
        })

    if not eligible:
        return None

    eligible.sort(key=lambda t: (0 if t["_label_set"] & prio else 1, t["number"]))
    chosen = eligible[0]
    chosen.pop("_label_set", None)
    return chosen


def _tt(*args: str, timeout: int = 30) -> subprocess.CompletedProcess | None:
    """Run `tt` and hand back the finished process, or None if it could not run.

    tt exits 123 when an object *refuses* an action (a real answer, not a bug)
    and 2 on a usage error. Callers decide which they care about.
    """
    try:
        return subprocess.run(["tt", *args], capture_output=True, text=True, timeout=timeout)
    except Exception as e:
        print(f"[agent-loop] Error: tt {' '.join(args)} failed: {e}", file=sys.stderr)
        return None


def _tt_json(*args: str) -> object | None:
    """Run a `tt` command expected to emit JSON and parse it."""
    result = _tt(*args)
    if result is None:
        return None
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        print(f"[agent-loop] Error: tt {' '.join(args)} exited {result.returncode}: {detail}", file=sys.stderr)
        return None
    try:
        return json.loads(result.stdout or "null")
    except json.JSONDecodeError as e:
        print(f"[agent-loop] Error: tt {' '.join(args)} returned non-JSON: {e}", file=sys.stderr)
        return None


def tt_project_for_cwd() -> str | None:
    """Find the tt project whose `path` contains the current directory.

    tt stores a filesystem path per project, so `--tt-project` with no value can
    resolve itself from where the loop is running.
    """
    projects = _tt_json("project", "ls", "--json")
    if not isinstance(projects, list):
        return None
    cwd = Path.cwd().resolve()
    best: tuple[int, str] | None = None
    for p in projects:
        raw = p.get("path")
        if not raw:
            continue
        try:
            root = Path(raw).expanduser().resolve()
        except OSError:
            continue
        if cwd == root or root in cwd.parents:
            depth = len(root.parts)
            if best is None or depth > best[0]:
                best = (depth, p["slug"])
    return best[1] if best else None


def tt_issue(number: int) -> dict | None:
    """Fetch one issue's full record (ls omits the body)."""
    payload = _tt_json("issue", "show", str(number))
    if not isinstance(payload, dict):
        return None
    issue = payload.get("issue")
    return issue if isinstance(issue, dict) else None


def pick_tt_ticket(project: str | None, attempts: dict[int, int]) -> dict | None:
    """Pick the next tt issue to work on.

    Eligible = status `todo`. `high` priority floats to the top, then lowest id
    first. tt has no labels and no dependency edges, so --skip-label,
    --prioritize-label and --skip-deps have no effect here; the title-based epic
    guard still applies.

    Returns {'kind': 'tt', 'number': int, 'title': str, 'body': str,
    'priority': str, 'project': str, 'labels': []} or None when nothing matches.
    """
    args = ["issue", "ls", "--json"]
    if project:
        args += ["--project", project]
    rows = _tt_json(*args)
    if not isinstance(rows, list):
        return None

    eligible = [
        r for r in rows
        if r.get("status") == "todo"
        and not EPIC_TITLE_RE.search(r.get("title") or "")
        and attempts.get(r["id"], 0) < TT_MAX_ATTEMPTS
    ]
    if not eligible:
        return None

    eligible.sort(key=lambda r: (0 if r.get("priority") == "high" else 1, r["id"]))
    chosen = eligible[0]

    full = tt_issue(chosen["id"])
    if full is None:
        return None
    return {
        "kind": "tt",
        "number": full["id"],
        "title": full.get("title") or "",
        "body": full.get("body") or "",
        "priority": full.get("priority") or "normal",
        "project": full.get("project") or "",
        "labels": [],
    }


def tt_set_status(ticket: dict, status: str) -> bool:
    """Move a tt issue to `status`.

    tt's `edit` is a whole-object write, not a patch — every editable field has
    to be sent back or it is cleared. Re-read the issue first so a change made
    between pick and now (in the TUI, or by the session itself) is not clobbered.
    """
    current = tt_issue(ticket["number"]) or ticket
    payload = json.dumps({
        "title": current.get("title") or "",
        "body": current.get("body") or "",
        "status": status,
        "priority": current.get("priority") or "normal",
    })
    result = _tt("issue", "action", str(ticket["number"]), "edit", payload)
    if result is None:
        return False
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        # 123 is a refusal — the object's answer. Report it, never retry blind.
        print(f"[agent-loop] tt refused status={status} on #{ticket['number']}: {detail}", file=sys.stderr)
        return False
    return True


def tt_issue_status(number: int) -> str | None:
    issue = tt_issue(number)
    return issue.get("status") if issue else None


def _tt_close_command(ticket: dict) -> str:
    """The exact shell line that marks a tt issue done, safely quoted."""
    payload = json.dumps({
        "title": ticket["title"],
        "body": ticket["body"],
        "status": "done",
        "priority": ticket["priority"],
    })
    return f"tt issue action {ticket['number']} edit {shlex.quote(payload)}"


def git_head_short() -> str:
    """Return short HEAD SHA, or 'no-git' if not in a repo."""
    try:
        return subprocess.check_output(
            ["git", "rev-parse", "--short=7", "HEAD"], stderr=subprocess.DEVNULL
        ).decode().strip()
    except Exception:
        return "no-git"


def git_commits_between(a: str, b: str) -> list[tuple[str, str]]:
    """Return [(short_sha, subject), ...] for commits in a..b. Empty on error or equal SHAs."""
    if a == "no-git" or b == "no-git" or a == b:
        return []
    try:
        out = subprocess.check_output(
            ["git", "log", f"{a}..{b}", "--pretty=format:%h %s"],
            stderr=subprocess.DEVNULL,
        ).decode().strip()
    except Exception:
        return []
    if not out:
        return []
    pairs: list[tuple[str, str]] = []
    for line in out.split("\n"):
        sha, _, subject = line.partition(" ")
        pairs.append((sha, subject))
    return pairs


def _branch_name(ticket: dict, pattern: str) -> str:
    """Render the feature-branch name from --branch-pattern."""
    if ticket["kind"] == "github":
        kind = "gh"
        ident = str(ticket["number"])
    elif ticket["kind"] == "tt":
        kind = "tt"
        ident = str(ticket["number"])
    else:
        kind = "lin"
        ident = ticket["identifier"].lower()
    return pattern.format(kind=kind, id=ident, slug=slugify(ticket["title"]))


def _ticket_ref(ticket: dict) -> str:
    """How the ticket is referenced in commit trailers / PR bodies (#N, tt#N or ENG-123).

    tt refs are prefixed so they can't be mistaken for — or silently auto-link
    to — a GitHub issue of the same number when the branch is pushed.
    """
    if ticket["kind"] == "github":
        return f"#{ticket['number']}"
    if ticket["kind"] == "tt":
        return f"tt#{ticket['number']}"
    return ticket["identifier"]


def render_ticket_block(
    ticket: dict,
    branch: str,
    close_mode: str = "commit",
    pr_base: str | None = None,
    branch_pattern: str = "agent/{kind}-{id}-{slug}",
) -> str:
    """Render the `## Ticket` block that replaces {{TICKET}} in the prompt."""
    labels = ", ".join(ticket.get("labels") or []) or "(none)"
    body = (ticket.get("body") or "").strip() or "_(no body)_"
    ref = _ticket_ref(ticket)

    if ticket["kind"] == "github":
        source = f"GitHub `{ticket['repo']}` issue #{ticket['number']}"
        meta = f"**Labels:** {labels}\n"
    elif ticket["kind"] == "tt":
        source = f"tt project `{ticket['project']}`, issue #{ticket['number']}"
        # tt has no labels; priority is the only other axis worth showing.
        meta = f"**Priority:** {ticket['priority']}\n"
    else:
        source = f"Linear project `{ticket['project']}`, issue `{ticket['identifier']}` (id `{ticket['id']}`)"
        meta = f"**Labels:** {labels}\n"

    header = (
        "## Ticket\n\n"
        f"**Source:** {source}\n"
        f"**Title:** {ticket['title']}\n"
        f"{meta}\n"
        "### Body\n\n"
        f"{body}\n\n"
    )

    if close_mode == "commit":
        if ticket["kind"] == "tt":
            close = (
                "### To close\n\n"
                "After committing and pushing on the current branch, mark the issue done.\n"
                "`tt`'s edit is a whole-object write, not a patch — every field must be sent "
                "back or it is cleared. This command already carries the issue's current "
                "title, body and priority, so run it as-is:\n\n"
                "```\n"
                f"{_tt_close_command(ticket)}\n"
                "```\n\n"
                "If you changed the title or body during the session, run `tt issue show "
                f"{ticket['number']}` first and send the updated fields instead.\n"
            )
            return header + close
        if ticket["kind"] == "github":
            n = ticket["number"]
            repo = ticket["repo"]
            close = (
                "### To close\n\n"
                "After committing and pushing on the current branch, run:\n\n"
                "```\n"
                "SHA=$(git rev-parse --short HEAD)\n"
                f"gh issue close {n} --repo {repo} --comment \"Landed on \\`{branch}\\` in $SHA.\"\n"
                "```\n"
            )
        else:
            ident = ticket["identifier"]
            close = (
                "### To close\n\n"
                f"After committing and pushing, use the Linear MCP to move issue `{ident}` to a "
                f"\"Done\" state and post a comment: \"Landed on `{branch}` in <short SHA>.\"\n"
            )
        return header + close

    if close_mode == "pr":
        feature_branch = _branch_name(ticket, branch_pattern)
        base = pr_base or "main"
        if ticket["kind"] == "tt":
            # tt has no `review` state, so the issue stays in `doing` until a human
            # merges. Marking it done here would make the PR look landed when it
            # isn't — and the loop only picks `todo`, so `doing` is enough to stop
            # it being picked up again.
            close = (
                "### To close\n\n"
                f"Cut a feature branch off `{base}`, commit, push, open a PR.\n\n"
                "```\n"
                f"git checkout -b {feature_branch}\n"
                "git add -A\n"
                f"git commit -m \"<prefix>: <subject> ({ref})\n"
                "\n"
                "<one-paragraph why / what changed>\n"
                "\n"
                f"Refs {ref}\n"
                "\n"
                "Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>\"\n"
                f"git push -u origin {feature_branch}\n"
                f"gh pr create --base {base} --head {feature_branch} \\\n"
                f"  --title \"<prefix>: <subject> ({ref})\" \\\n"
                f"  --body \"Refs {ref}\"\n"
                "```\n\n"
                f"Leave the tt issue in `doing` — do NOT mark it done. It is marked done "
                "when the PR merges.\n"
            )
            return header + close
        if ticket["kind"] == "github":
            repo = ticket["repo"]
            close = (
                "### To close\n\n"
                f"Cut a feature branch off `{base}`, commit, push, open a PR. The `Closes {ref}` "
                "trailer auto-closes the issue on merge — do NOT close the issue manually.\n\n"
                "```\n"
                f"git checkout -b {feature_branch}\n"
                "git add -A\n"
                f"git commit -m \"<prefix>: <subject> ({ref})\n"
                "\n"
                "<one-paragraph why / what changed>\n"
                "\n"
                f"Closes {ref}\n"
                "\n"
                "Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>\"\n"
                f"git push -u origin {feature_branch}\n"
                f"gh pr create --repo {repo} --base {base} --head {feature_branch} \\\n"
                f"  --title \"<prefix>: <subject> ({ref})\" \\\n"
                f"  --body \"Closes {ref}\"\n"
                "```\n"
            )
        else:
            close = (
                "### To close\n\n"
                f"Cut a feature branch off `{base}`, commit, push, open a PR. The Linear-GitHub "
                f"integration moves `{ref}` to \"In Review\" on PR open and to \"Done\" on merge — "
                "do NOT change the Linear state manually.\n\n"
                "```\n"
                f"git checkout -b {feature_branch}\n"
                "git add -A\n"
                f"git commit -m \"<prefix>: <subject> ({ref})\n"
                "\n"
                "<one-paragraph why / what changed>\n"
                "\n"
                f"Closes {ref}\n"
                "\n"
                "Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>\"\n"
                f"git push -u origin {feature_branch}\n"
                f"gh pr create --base {base} --head {feature_branch} \\\n"
                f"  --title \"<prefix>: <subject> ({ref})\" \\\n"
                f"  --body \"Closes {ref}\"\n"
                "```\n"
            )
        return header + close

    raise ValueError(f"Unknown close_mode: {close_mode!r}")


def current_branch() -> str:
    """Return the current git branch, or '(detached)' on error."""
    try:
        return subprocess.check_output(
            ["git", "rev-parse", "--abbrev-ref", "HEAD"], stderr=subprocess.DEVNULL
        ).decode().strip() or "(detached)"
    except Exception:
        return "(detached)"


def slugify(title: str, max_words: int = 5) -> str:
    """Lowercase, non-alnum → '-', collapse, take the first N words."""
    words = re.findall(r"[A-Za-z0-9]+", title.lower())
    return "-".join(words[:max_words]) or "ticket"


def github_default_branch(repo: str) -> str | None:
    """Return the repo's default branch (e.g. 'main') via gh, or None on failure."""
    try:
        result = subprocess.run(
            ["gh", "repo", "view", repo, "--json", "defaultBranchRef", "-q", ".defaultBranchRef.name"],
            capture_output=True,
            text=True,
            timeout=15,
        )
    except Exception:
        return None
    if result.returncode != 0:
        return None
    return result.stdout.strip() or None


def github_issues_with_open_prs(repo: str) -> set[int]:
    """Return the set of issue numbers referenced by any open PR via Closes/Fixes/Resolves #N."""
    try:
        result = subprocess.run(
            ["gh", "pr", "list", "--repo", repo, "--state", "open", "--json", "body", "--limit", "200"],
            capture_output=True,
            text=True,
            timeout=30,
        )
    except Exception:
        return set()
    if result.returncode != 0:
        return set()
    prs = json.loads(result.stdout or "[]")
    nums: set[int] = set()
    for pr in prs:
        for m in PR_CLOSES_RE.findall(pr.get("body") or ""):
            nums.add(int(m))
    return nums


def github_issue_state(repo: str, number: int) -> str | None:
    """Return 'OPEN' / 'CLOSED', or None on failure."""
    try:
        result = subprocess.run(
            ["gh", "issue", "view", str(number), "--repo", repo, "--json", "state"],
            capture_output=True, text=True, timeout=15,
        )
        if result.returncode != 0:
            return None
        return json.loads(result.stdout).get("state")
    except Exception:
        return None


def tail_last_message(log_path: Path, max_chars: int = 240) -> str:
    """Return the last non-blank paragraph from a session log, truncated."""
    try:
        text = log_path.read_text(errors="replace")
    except Exception:
        return ""
    if not text.strip():
        return ""
    paragraphs = [p.strip() for p in re.split(r"\n\s*\n", text) if p.strip()]
    if not paragraphs:
        return ""
    last = re.sub(r"\s+", " ", paragraphs[-1])
    if len(last) > max_chars:
        return last[: max_chars - 1].rstrip() + "…"
    return last


def format_duration(secs: float) -> str:
    """Format seconds as Hh MMm SSs / Mm SSs / Ss."""
    s = int(round(secs))
    h, rem = divmod(s, 3600)
    m, s = divmod(rem, 60)
    if h:
        return f"{h}h {m:02d}m {s:02d}s"
    if m:
        return f"{m}m {s:02d}s"
    return f"{s}s"


def run_session(
    prompt_text: str,
    model: str,
    log_path: Path,
) -> subprocess.CompletedProcess:
    cmd = ["claude", "--dangerously-skip-permissions", "-p", prompt_text, "--model", model]
    with open(log_path, "w") as logfile:
        return subprocess.run(cmd, stdout=logfile, stderr=logfile)


def run_unblock_session(
    failure_reason: str,
    log_path: Path,
    model: str,
    ticket: dict | None = None,
) -> bool:
    """Spawn a child session to diagnose and fix a loop failure.

    Returns True if the loop should continue, False if it should stop.
    The child exits 1 to signal an unrecoverable stop.
    """
    ticket_summary = ""
    if ticket:
        ticket_summary = f"Ticket: {_ticket_ref(ticket)} — {ticket['title']}\n\n"

    prompt = f"""\
The agent-loop encountered an issue and needs you to unblock it.

Failure: {failure_reason}

{ticket_summary}Last session log:
{tail_last_message(log_path, max_chars=1200)}

Diagnose and fix the issue if you can (bad git state, dirty working tree, \
ambiguous ticket, missing dependency). Do not do the ticket's work.

If the loop should stop (unrecoverable error, infra is broken, ticket is \
genuinely blocked with no fix available), run: exit 1
Otherwise fix what you can and exit normally so the loop continues.
"""
    unblock_log = log_path.with_suffix(".unblock.log")
    print(f"    Unblock:   spawning child session → {unblock_log}")
    result = run_session(prompt, model, unblock_log)
    tail = tail_last_message(unblock_log)
    if tail:
        print(f"    Unblock:   {tail}")
    return result.returncode == 0


# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

def cmd_init(args: argparse.Namespace) -> None:
    print("[agent-loop] Starting init session — Claude will interview you and write scripts/agent-prompt.md")
    subprocess.run(
        ["claude", "--dangerously-skip-permissions", INIT_META_PROMPT],
    )


def cmd_run(args: argparse.Namespace) -> None:
    # Validation
    if args.check_interval is not None and args.stop_at is None and args.stop_after is None:
        print("Error: --check-interval requires --stop-at or --stop-after", file=sys.stderr)
        sys.exit(1)

    if not args.prompt:
        print("Error: --prompt <path> is required.", file=sys.stderr)
        sys.exit(1)
    prompt_path = Path(args.prompt).expanduser().resolve()
    if not prompt_path.exists():
        print(f"Error: prompt file not found: {prompt_path}", file=sys.stderr)
        sys.exit(1)
    prompt_text = prompt_path.read_text()

    # Resolve picker config (CLI overrides; otherwise defaults).
    skip_labels = _split_label_csv(args.skip_label)
    if skip_labels is None:
        skip_labels = list(DEFAULT_SKIP_LABELS)
    priority_labels = _split_label_csv(args.prioritize_label)
    if priority_labels is None:
        priority_labels = list(DEFAULT_PRIORITY_LABELS)

    # Determine backlog source
    backlog_source = None
    if args.linear_project:
        backlog_source = ("linear", args.linear_project)
    elif args.github_repo:
        backlog_source = ("github", args.github_repo)
    elif args.tt_project is not None:
        # Bare --tt-project resolves the project from the cwd via tt's stored path.
        tt_project = args.tt_project
        if tt_project == TT_PROJECT_AUTO:
            tt_project = tt_project_for_cwd()
            if tt_project is None:
                print(
                    "Error: --tt-project given with no value and no tt project's path "
                    f"covers {Path.cwd()}.\n"
                    "Set one with `tt project setPath`, or pass --tt-project SLUG.",
                    file=sys.stderr,
                )
                sys.exit(1)
        backlog_source = ("tt", tt_project)

    # Marker is only required when a backlog source is configured (ticket-driven loop).
    # No backlog source = QA-style loop where the prompt runs as-is each iteration.
    if backlog_source is not None and TICKET_MARKER not in prompt_text:
        print(
            f"Error: prompt {prompt_path} is missing the {TICKET_MARKER} placeholder.\n"
            f"When a backlog source is configured, agent-loop pre-picks the ticket and "
            f"substitutes it at {TICKET_MARKER}. Drop the 'Pick a ticket' section from "
            f"the prompt and add `{TICKET_MARKER}` where the rendered ticket block should appear.",
            file=sys.stderr,
        )
        sys.exit(2)

    # tt has no shelved state, so failed picks are remembered for this run only.
    tt_attempts: dict[int, int] = {}

    def _pick() -> dict | None:
        if backlog_source is None:
            return None
        if backlog_source[0] == "tt":
            return pick_tt_ticket(backlog_source[1], tt_attempts)
        if backlog_source[0] == "linear":
            return pick_linear_ticket(
                backlog_source[1],
                args.linear_state,
                skip_labels,
                priority_labels,
                args.skip_deps,
            )
        return pick_github_ticket(
            backlog_source[1],
            args.label,
            args.milestone,
            skip_labels,
            priority_labels,
            args.skip_deps,
            close_mode=args.close_mode,
        )

    branch = current_branch()

    # Resolve PR base if --close-mode=pr and no override.
    pr_base = args.pr_base
    if args.close_mode == "pr" and pr_base is None and backlog_source and backlog_source[0] == "github":
        pr_base = github_default_branch(backlog_source[1]) or "main"
    elif args.close_mode == "pr" and pr_base is None:
        pr_base = "main"

    # Dry-run: pick a ticket, print the rendered block, exit. No Claude spawn.
    if args.print_ticket:
        if backlog_source is None:
            print(
                "Error: --print-ticket requires --github-repo, --linear-project or --tt-project.",
                file=sys.stderr,
            )
            sys.exit(2)
        ticket = _pick()
        if ticket is None:
            print("(no matching ticket)")
            sys.exit(0)
        print(render_ticket_block(ticket, branch, args.close_mode, pr_base, args.branch_pattern))
        sys.exit(0)

    name = args.name or (prompt_path.stem if prompt_path else "agent")
    log_dir = Path(args.log_dir or f"~/logs/agent-loop/{name}").expanduser().resolve()
    log_dir.mkdir(parents=True, exist_ok=True)

    if args.stop_at:
        deadline = parse_stop_at(args.stop_at)
    elif args.stop_after is not None:
        deadline = datetime.now() + timedelta(seconds=args.stop_after)
    else:
        deadline = None
    check_interval_secs = args.check_interval  # already int seconds or None

    # Startup summary
    print("=== agent-loop ===")
    print(f"    Prompt:  {prompt_path or '(inline)'}")
    print(f"    Model:   {args.model}")
    print(f"    Logs:    {log_dir}")
    print(f"    Branch:  {branch}")
    if deadline:
        print(f"    Stop at: {deadline.strftime('%Y-%m-%d %H:%M')}")
    else:
        print("    Stop at: (none)")
    if backlog_source is None:
        print("    Backlog: (no source — runs prompt as-is each iteration)")
    elif backlog_source[0] == "tt":
        print(f"    Backlog: tt project '{backlog_source[1]}' status=todo")
    elif backlog_source[0] == "linear":
        print(f"    Backlog: Linear project '{backlog_source[1]}' state={args.linear_state}")
    else:
        bits = []
        if args.label:
            bits.append(f"label={args.label}")
        if args.milestone:
            bits.append(f"milestone={args.milestone!r}")
        print(f"    Backlog: GitHub {backlog_source[1]} " + (" ".join(bits) or "(no filter)"))
    if backlog_source is not None and backlog_source[0] == "tt":
        # Be explicit that the label/dep flags are inert here rather than let the
        # summary imply filters that tt cannot express.
        print(f"    Pick:    high-priority first, then lowest id (max {TT_MAX_ATTEMPTS} attempts/issue)")
        if args.skip_label or args.prioritize_label or args.skip_deps:
            print("             note: --skip-label/--prioritize-label/--skip-deps are ignored (tt has no labels or deps)")
    elif backlog_source is not None:
        print(f"    Pick:    skip={','.join(skip_labels) or '(none)'} priority={','.join(priority_labels) or '(none)'} skip_deps={args.skip_deps}")
        print(f"    Close:   mode={args.close_mode}" + (f" pr_base={pr_base}" if args.close_mode == "pr" else ""))
    print()

    session = 0

    while True:
        if past_deadline(deadline):
            print(f"=== Deadline reached ({datetime.now().strftime('%H:%M:%S')}) — stopping ===")
            break

        ticket: dict | None = None
        if backlog_source is not None:
            print(f"--- Picking ticket ({datetime.now().strftime('%H:%M:%S')}) ---")
            ticket = _pick()

            if ticket is None:
                if check_interval_secs is None:
                    print(f"=== No matching ticket ({datetime.now().strftime('%H:%M:%S')}) — stopping ===")
                    break
                wake = datetime.now() + timedelta(seconds=check_interval_secs)
                print(f"    No matching ticket — sleeping until {wake.strftime('%H:%M:%S')}")
                time.sleep(check_interval_secs)
                continue

        session += 1

        head_before = git_head_short()
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        log_path = log_dir / f"{name}_{timestamp}_{head_before}.log"

        print(f"--- Session #{session} ({datetime.now().strftime('%H:%M:%S')}) ---")
        if ticket is None:
            print("    Picked up: (no ticket — running prompt as-is)")
        elif ticket["kind"] == "github":
            print(f"    Picked up: #{ticket['number']} {ticket['title']}")
        elif ticket["kind"] == "tt":
            print(f"    Picked up: tt#{ticket['number']} {ticket['title']}")
            tt_attempts[ticket["number"]] = tt_attempts.get(ticket["number"], 0) + 1
            if tt_set_status(ticket, "doing"):
                print("    Claimed:   moved to 'doing'")
            else:
                print("    Claimed:   (could not move to 'doing'; continuing)")
        else:
            print(f"    Picked up: {ticket['identifier']} {ticket['title']}")
            success, state_name = linear_mark_in_progress(ticket["id"])
            if success:
                print(f"    Claimed:   moved to '{state_name}'")
            else:
                print("    Claimed:   (could not auto-advance state; continuing)")
        print(f"    Log:       {log_path}")

        if ticket is None:
            session_prompt = prompt_text
        else:
            session_prompt = prompt_text.replace(
                TICKET_MARKER,
                render_ticket_block(ticket, branch, args.close_mode, pr_base, args.branch_pattern),
            )

        start = time.monotonic()
        result = run_session(session_prompt, args.model, log_path)
        duration = time.monotonic() - start

        head_after = git_head_short()
        commits = git_commits_between(head_before, head_after)

        if result.returncode != 0:
            print(f"    Result:    ✗ session crashed (exit code {result.returncode})")
            tail = tail_last_message(log_path)
            if tail:
                print(f"    Last msg:  {tail}")
            print(f"    Duration:  {format_duration(duration)}")
            if not run_unblock_session(f"Claude exited with code {result.returncode}", log_path, args.model, ticket):
                print(f"\n=== agent-loop stopping after session #{session} (unblock failed) ===")
                break
            continue

        if not commits:
            print(f"    Result:    — no progress (HEAD unchanged at {head_before})")
            tail = tail_last_message(log_path)
            if tail:
                print(f"    Last msg:  {tail}")
            print(f"    Duration:  {format_duration(duration)}")
            # For Linear tickets: revert the state back to Backlog so the next picker
            # pass can re-evaluate. We only do this when the ticket hasn't been shelved
            # via the `tracker` label — that label is the agent's "do not retry" signal.
            if ticket is not None and ticket["kind"] == "tt":
                if tt_set_status(ticket, "todo"):
                    print(f"    Reverted:  tt#{ticket['number']} moved back to 'todo'")
                else:
                    print(f"    Reverted:  could not move tt#{ticket['number']} back (continuing)")
                used = tt_attempts.get(ticket["number"], 0)
                if used >= TT_MAX_ATTEMPTS:
                    print(f"    Shelved:   tt#{ticket['number']} hit {TT_MAX_ATTEMPTS} attempts — skipped for the rest of this run")
            elif ticket is not None and ticket["kind"] == "linear":
                current_labels = {l.lower() for l in linear_issue_labels(ticket["id"])}
                if "tracker" in current_labels:
                    print(f"    Shelved:   {ticket['identifier']} has `tracker` label — leaving state as-is")
                else:
                    reverted, state_name = linear_mark_backlog(ticket["id"])
                    if reverted:
                        print(f"    Reverted:  {ticket['identifier']} moved back to '{state_name}'")
                    else:
                        print(f"    Reverted:  could not move {ticket['identifier']} back (continuing)")
            if check_interval_secs is None:
                print(f"\n=== agent-loop stopping after session #{session} (no commit landed and no --check-interval) ===")
                break
            continue

        # Success.
        commit_summary = ", ".join(f"{sha} {subject}" for sha, subject in commits[:3])
        if len(commits) > 3:
            commit_summary += f", +{len(commits) - 3} more"
        print(f"    Result:    ✓ committed ({commit_summary})")

        # Did the picked-up ticket actually get closed? Best-effort signal.
        if ticket is None:
            pass
        elif ticket["kind"] == "github":
            state = github_issue_state(ticket["repo"], ticket["number"])
            if state == "CLOSED":
                print(f"               closed #{ticket['number']}")
        elif ticket["kind"] == "tt":
            state = tt_issue_status(ticket["number"])
            if state == "done":
                print(f"               closed tt#{ticket['number']}")
            elif args.close_mode == "commit":
                # Commit landed but the session skipped its close step — the issue
                # is stranded in `doing` and no longer visible to the picker.
                print(f"               warning: tt#{ticket['number']} still '{state}' — close step was not run")
        else:
            state = linear_issue_state(ticket["id"])
            if state == "completed":
                print(f"               closed {ticket['identifier']}")

        print(f"    Duration:  {format_duration(duration)}")
        # After a successful commit, jump straight into the next pick. The 5s pause
        # gives git/network a moment to settle and leaves a Ctrl-C window. The
        # --check-interval setting is reserved for empty-backlog / no-op cases.
        time.sleep(5)

    print(f"\n=== agent-loop finished after {session} session(s) ===")


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="agent-loop",
        description="Spawn repeating Claude Code sessions against a Linear or GitHub Issues backlog.",
    )
    sub = parser.add_subparsers(dest="subcommand")

    # init
    sub.add_parser("init", help="Interview mode: generate scripts/agent-prompt.md for this project")

    # run
    run_p = sub.add_parser("run", help="Run the agent loop (default when no subcommand given)")
    _add_run_args(run_p)

    # Also add run args to the top-level parser so `agent-loop --prompt ...` works
    _add_run_args(parser)

    return parser


def _split_label_csv(values: list[str] | None) -> list[str] | None:
    """Flatten repeated --skip-label/--prioritize-label flags + comma-split each entry."""
    if values is None:
        return None
    out: list[str] = []
    for v in values:
        for part in v.split(","):
            part = part.strip()
            if part:
                out.append(part)
    return out


def _add_run_args(p: argparse.ArgumentParser) -> None:
    p.add_argument("--prompt", metavar="PATH", help="Path to prompt markdown file. Must contain the {{TICKET}} placeholder when a backlog source is configured.")
    backlog = p.add_mutually_exclusive_group()
    backlog.add_argument("--linear-project", metavar="NAME", help="Linear project name (uses LINEAR_API_KEY env var)")
    backlog.add_argument("--github-repo", metavar="OWNER/REPO", help="GitHub repo for issue backlog")
    backlog.add_argument(
        "--tt-project",
        nargs="?",
        const=TT_PROJECT_AUTO,
        default=None,
        metavar="SLUG",
        help="tt project slug for the issue backlog (picks status=todo, high priority first). Pass with no value to resolve the project from the current directory via its tt path.",
    )
    p.add_argument("--linear-state", default="Backlog", metavar="STATE", help="Linear state name to check for work (default: Backlog)")
    p.add_argument("--label", default=None, metavar="LABEL", help="GitHub Issues label filter passed to gh issue list (optional)")
    p.add_argument("--milestone", default=None, metavar="NAME", help="GitHub Issues milestone filter (optional)")
    p.add_argument(
        "--skip-label",
        action="append",
        default=None,
        metavar="LABEL",
        help=f"Drop issues with these labels. Repeatable; comma-split. Default: {','.join(DEFAULT_SKIP_LABELS)}.",
    )
    p.add_argument(
        "--prioritize-label",
        action="append",
        default=None,
        metavar="LABEL",
        help=f"Pick issues with these labels first. Repeatable; comma-split. Default: {','.join(DEFAULT_PRIORITY_LABELS)}.",
    )
    p.add_argument(
        "--skip-deps",
        action="store_true",
        help="Skip issues whose body says 'blocked by #N' / 'depends on #N' where #N (or ENG-N for Linear) is still open.",
    )
    p.add_argument(
        "--close-mode",
        choices=["commit", "pr"],
        default="commit",
        help="commit: stage+commit on the working branch, push, close issue (default). pr: cut a feature branch, push, open a PR with `Closes #N` so merge auto-closes.",
    )
    p.add_argument(
        "--pr-base",
        metavar="BRANCH",
        help="Base branch for --close-mode=pr. Default: the GitHub repo's default branch (gh repo view).",
    )
    p.add_argument(
        "--branch-pattern",
        default="agent/{kind}-{id}-{slug}",
        metavar="TMPL",
        help="Branch name template for --close-mode=pr. Vars: {kind} (gh|tt|lin), {id} (number/identifier, lowercased), {slug} (5-word kebab-case of the title). Default: agent/{kind}-{id}-{slug}.",
    )
    p.add_argument("--model", default="opus", metavar="MODEL", help="Claude model (default: opus)")
    deadline = p.add_mutually_exclusive_group()
    deadline.add_argument("--stop-at", metavar="HH:MM", help="Hard deadline at a wall-clock time; wraps to tomorrow if already past. Cross-platform alternative: --stop-after.")
    deadline.add_argument("--stop-after", metavar="DURATION", type=parse_duration, help="Hard deadline N from now, e.g. 6h, 90m, 30s. Cross-platform — no `date` arithmetic in the shell.")
    p.add_argument(
        "--check-interval",
        metavar="DURATION",
        type=parse_duration,
        help="Sleep this long after every session ends and when the backlog is empty, e.g. 15m, 1h (requires --stop-at or --stop-after)",
    )
    p.add_argument("--log-dir", metavar="DIR", help="Session log directory (default: ~/logs/agent-loop/<name>/)")
    p.add_argument("--name", metavar="NAME", help="Name used in log filenames (default: prompt filename stem)")
    p.add_argument("--verbose", action="store_true", help="Print raw backlog check responses for debugging")
    p.add_argument(
        "--print-ticket",
        action="store_true",
        help="Pick a ticket, render the {{TICKET}} block, print it, and exit. Does not spawn Claude. Useful for dry-running selection rules.",
    )


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()

    if args.subcommand == "init":
        cmd_init(args)
    elif args.subcommand == "run":
        if not args.prompt:
            parser.error("pass --prompt for the run subcommand")
        cmd_run(args)
    elif args.subcommand is None:
        # No subcommand — treat as `run` if --prompt given, else print help
        if args.prompt:
            cmd_run(args)
        else:
            parser.print_help()
            sys.exit(0)
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
